#!/bin/sh /etc/rc.common
#
# OpenWISP Monitoring DHCP snooping

# shellcheck disable=SC2034
START=95
STOP=15

USE_PROCD=1

start_service() {
	procd_open_instance
	procd_set_param command /usr/sbin/openwisp-monitoring-dhcp-snooping
	procd_set_param respawn 3600 5 0
	procd_set_param stderr 1
	procd_close_instance
}
